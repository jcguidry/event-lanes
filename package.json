{
  "name": "@jcguidry/event-lanes",
  "version": "0.1.0",
  "description": "Embeddable entity-lane timelines for grouped events, transfers, and explicit causal relationships.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./schema": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "esbuild": "0.28.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jcguidry/event-lanes.git"
  }
}
